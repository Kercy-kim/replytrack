{
  "name": "replytrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded customer support follow-up assistant",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "test:web": "node scripts/check-completeness.mjs",
    "check": "node scripts/check.mjs",
    "eval:ai": "node --env-file=.env scripts/evaluate-ai.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
