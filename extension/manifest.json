{
  "manifest_version": 3,
  "name": "ReplyTrack — 상담 확인표",
  "version": "0.1.0",
  "description": "선택한 고객센터 대화의 빠진 답변을 확인하고, 남은 질문으로 재문의 초안을 만듭니다.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "contextMenus", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "ReplyTrack에서 선택한 대화 가져오기" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:3100; base-uri 'none'; form-action 'none'"
  }
}
