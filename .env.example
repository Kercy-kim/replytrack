# Optional: use the in-app connection settings for a memory-only API key instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3100
# Stored locally. Do not commit customer conversations.
REPLYTRACK_DATA_DIR=./data
# Public HTTPS deployment only. Render supplies its own URL automatically.
# REPLYTRACK_PUBLIC_ORIGIN=https://your-service.onrender.com
# REPLYTRACK_DEMO_PASSWORD=choose-a-private-password-at-least-16-characters
# PostgreSQL enables individual accounts. Existing password seeds the admin once.
# DATABASE_URL=postgresql://user:password@host:5432/database
