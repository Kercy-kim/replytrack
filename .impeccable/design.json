    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "현재 구현의 버튼 변형. 별도 active 색상은 정의되어 있지 않다.",
      "html": "<button class=\"ds-button-danger\">상담 삭제</button>",
      "css": ".ds-button-danger{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;padding:12px 17px;border-radius:9px;font-family:Inter, \"Pretendard\", \"Segoe UI\", \"Malgun Gothic\", sans-serif;line-height:1.4;font-weight:600;font-size:13px;white-space:nowrap;cursor:pointer;transition:background .15s,border-color .15s,transform .15s;background:#aa463d;color:#fff;}.ds-button-danger:hover:not(:disabled){transform:translateY(-1px);}.ds-button-danger:focus-visible{outline:3px solid #88ad66;outline-offset:4px}.ds-button-danger:disabled{opacity:.48;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
