# Keep the portable Impeccable launcher executable by POSIX shells after checkout.
.agents/skills/impeccable/scripts/impeccable text eol=lf

# Preserve the recorded handoff prompt and evaluator hashes across Windows checkouts.
src/handoff.mjs text eol=lf
scripts/evaluate-handoff.mjs text eol=lf

# The public replay cites the exact byte hash of its synthetic source record.
evals/results/presentation/*.json text eol=lf
public/presentation-data.json text eol=lf
